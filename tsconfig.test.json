{
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "node",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"outDir": "./out",
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node", "mocha"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", ".vscode-test"]
}
